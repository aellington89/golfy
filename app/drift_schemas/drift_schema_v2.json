  "fixed_sql": [
    {
      "name": "courses",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"courses\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"game_title\" TEXT NOT NULL, UNIQUE (\"name\", \"game_title\"));"
        }
      ]
    },
    {
      "name": "rounds",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"rounds\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"date\" TEXT NOT NULL, \"course_id\" INTEGER NOT NULL REFERENCES courses (id) ON DELETE RESTRICT, \"round_number\" INTEGER NOT NULL DEFAULT 1, \"tee_set\" TEXT NULL, \"weather\" TEXT NULL, \"wind_speed_mph\" INTEGER NULL, \"difficulty\" TEXT NULL, \"notes\" TEXT NULL, \"migration_canary\" TEXT NULL, UNIQUE (\"date\", \"course_id\", \"round_number\"));"
        }
      ]
    },
    {
      "name": "hole_results",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"hole_results\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"round_id\" INTEGER NOT NULL REFERENCES rounds (id) ON DELETE CASCADE, \"hole_number\" INTEGER NOT NULL CHECK (hole_number BETWEEN 1 AND 18), \"par\" INTEGER NOT NULL CHECK (par BETWEEN 3 AND 5), \"score\" INTEGER NOT NULL CHECK (score >= 1), \"yards\" INTEGER NOT NULL CHECK (yards >= 0), \"fairway_hit\" INTEGER NULL CHECK (\"fairway_hit\" IN (0, 1)), \"gir\" INTEGER NOT NULL CHECK (\"gir\" IN (0, 1)), \"putts\" INTEGER NOT NULL CHECK (putts >= 0), \"up_down_attempt\" INTEGER NOT NULL CHECK (\"up_down_attempt\" IN (0, 1)), \"up_down_success\" INTEGER NOT NULL CHECK (\"up_down_success\" IN (0, 1)), \"penalty_strokes\" INTEGER NOT NULL CHECK (penalty_strokes >= 0), \"bunker_visited\" INTEGER NOT NULL CHECK (\"bunker_visited\" IN (0, 1)), \"sand_save\" INTEGER NOT NULL CHECK (\"sand_save\" IN (0, 1)), \"drive_distance_yards\" INTEGER NOT NULL CHECK (drive_distance_yards >= 0), \"approach_distance_yards\" INTEGER CHECK (approach_distance_yards >= 0), \"tee_club\" TEXT NULL, \"notes\" TEXT NULL, UNIQUE (\"round_id\", \"hole_number\"));"
        }
      ]
    },
